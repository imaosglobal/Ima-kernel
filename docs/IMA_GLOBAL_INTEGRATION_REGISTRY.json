{
  "schema_version": "1.0.0",
  "purpose": "Global IMA integration and partnership map. This registry records targets and verified integration paths; it never claims a partnership or connection without evidence.",
  "status_rules": {
    "DISCOVERED": "Public organization or ecosystem identified.",
    "ELIGIBLE_PATH_FOUND": "Official API, partner, developer, research, grant, accelerator or contact path identified.",
    "PREPARED": "IMA integration package or application material is prepared.",
    "AUTHORIZED": "Human/org authorization or credentials exist.",
    "CONNECTED": "Technical connection is authenticated and tested.",
    "VERIFIED": "Connection works end-to-end with reproducible evidence.",
    "BLOCKED": "Path requires unavailable approval, credential, geography, legal status or other external dependency."
  },
