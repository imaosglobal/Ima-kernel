  "ranking": {
    "priority_order": [
      "primary evidence",
      "research infrastructure",
      "open datasets/APIs",
      "peer-reviewed literature",
      "preprints",
      "expert/community interpretation",
      "media/commentary"
    ],
    "dimensions": [
      "evidence_strength",
      "recency",
      "independence",
      "reproducibility",
      "openness",
      "coverage",
      "relevance_to_IMA",
      "accessibility",
      "cost",
      "licensing",
      "privacy",
      "safety"
    ]
  },
  "person_connection": {
    "allowed": [
      "discover public researcher profiles",
      "link publications to public researcher identifiers",
      "map expertise to topics",
      "surface public institutional contact routes"
    ],
    "prohibited_without_consent": [
      "scrape private contact details",
      "infer private identity attributes",
      "send unsolicited messages",
      "claim collaboration",
      "claim endorsement",
      "store passwords or private credentials"
    ]
  },
  "daily_loop": {
    "orchestrator": "existing unified daily IMA Global Health Loop",
    "no_new_scheduler": true,
    "actions": [
      "scan configured public sources",
      "detect gaps and new evidence",
      "map researchers and institutions by public provenance",
      "compare disciplines and counterevidence",
      "propose high-value connections",
      "verify before integration",
      "append findings to development journal"
    ]
  }
