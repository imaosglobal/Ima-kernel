{
  "schema_version": "1.0.0",
  "name": "IMA Universal Adapter Registry",
  "status": "DESIGNED",
  "rule": "An adapter is not considered LIVE until implementation, reproducible test, deployed surface and end-to-end verification exist.",
  "transports": [
    "HTTPS",
    "WSS",
    "Streamable HTTP MCP",
    "stdio MCP",
    "WebMCP",
    "Bluetooth LE",
    "USB",
    "local IPC",
    "satellite/IP",
    "future custom transport"
  ],
  "intelligence_providers": {
    "strategy": "provider-neutral",
    "adapters": [
      "MCP",
      "provider-native-tools",
      "OpenAI-compatible",
      "Anthropic-compatible",
      "Gemini-compatible",
      "local-model",
      "future-provider"
    ]
  },
