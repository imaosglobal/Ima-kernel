#!/data/data/com.termux/files/usr/bin/python

from pathlib import Path
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

ROOT = Path.home() / "ima_kernel"
STAGE = ROOT / ".ima" / "canonical_staging"
GUARD = ROOT / ".ima" / "canonical_state_guard"

FILES = [
    "founder/data/ima_learning_journal.json",
    "founder/data/ima_memory.json",
    "founder/data/policy_memory.json",
    "startup/ima_memory.json",
]

def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def fail(msg):
    sys.exit(1)

def main():


    if subprocess.run(
        [str(ROOT / "bin" / "ima-git-preflight")]
    ).returncode != 0:
        fail("preflight failed")

    staged = []

    for name in FILES:
        p = STAGE / name

        if p.exists():
            staged.append((name, p))

    if not staged:
        fail("no staged canonical candidates")


    for name, p in staged:

    answer = input("PROMOTE THESE CANDIDATES? type PROMOTE: ")

    if answer != "PROMOTE":
        fail("promotion cancelled")

    for name, source in staged:

        target = ROOT / name
        target.parent.mkdir(parents=True, exist_ok=True)

        old_mode = target.stat().st_mode if target.exists() else 0o444

        if target.exists():
            target.chmod(0o600)

        tmp = target.with_suffix(target.suffix + ".promotion_tmp")

        shutil.copy2(source, tmp)
        os.replace(tmp, target)

        target.chmod(0o444)


    manifest = {
        "type": "IMA_CANONICAL_MEMORY_STATE",
        "version": "2.0",
        "created_at": time.time(),
        "files": {}
    }

    for name in FILES:
        p = ROOT / name

        manifest["files"][name] = {
            "sha256": sha256(p),
            "bytes": p.stat().st_size
        }

    manifest_path = GUARD / "memory.manifest.json"
    manifest_path.write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2),
        encoding="utf-8"
    )

    subprocess.run(
        ["sha256sum"] + FILES,
        cwd=ROOT,
        check=True,
        stdout=(GUARD / "memory.freeze.sha256").open("w")
    )


if __name__ == "__main__":
    main()
