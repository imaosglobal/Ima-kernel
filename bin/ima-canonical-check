#!/data/data/com.termux/files/usr/bin/sh

set -e

cd "$HOME/ima_kernel"

MANIFEST=".ima/canonical_state_guard/memory.manifest.json"

if [ ! -f "$MANIFEST" ]; then
    echo "ERROR: canonical memory manifest missing"
    exit 1
fi

python3 - <<'PY'
from pathlib import Path
import hashlib
import json
import sys

manifest = json.loads(
    Path(".ima/canonical_state_guard/memory.manifest.json")
    .read_text()
)

failed = False

for name, meta in manifest["files"].items():
    p = Path(name)

    if not p.exists():
        print("MISSING:", name)
        failed = True
        continue

    actual = hashlib.sha256(p.read_bytes()).hexdigest()
    expected = meta["sha256"]

    if actual != expected:
        print("CHANGED:", name)
        print(" expected:", expected)
        print(" actual:  ", actual)
        failed = True
    else:
        print("OK:", name)

if failed:
    print("CANONICAL STATE: DIRTY")
    sys.exit(1)

print("CANONICAL STATE: CLEAN")
PY
