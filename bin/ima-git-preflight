#!/data/data/com.termux/files/usr/bin/sh

set -e

cd "$HOME/ima_kernel"

echo "=== IMA CANONICAL GIT PREFLIGHT ==="

echo
echo "SERVICE:"
sv status "$PREFIX/var/service/ima_learning" 2>&1 || true

echo
echo "WRITERS:"

for D in /proc/[0-9]*; do
    P="${D##*/}"
    [ -r "$D/cmdline" ] || continue

    CMD="$(tr '\0' ' ' < "$D/cmdline" 2>/dev/null)"

    case "$CMD" in
        *"ima_one_brain.py"*|\
        *"ima_bridge.py"*|\
        *"mother_server"*|\
        *"continuity_runtime.py"*)
            echo "ERROR: writer active"
            echo "PID=$P"
            echo "CMD=$CMD"
            exit 1
            ;;
    esac
done

echo "NO CANONICAL WRITER"

echo
echo "CANONICAL MEMORY:"
ima-canonical-check

echo
echo "GIT:"
git diff --check
git diff --cached --check
git ls-files >/dev/null

echo
echo "GIT STATUS:"
git status --short

echo
echo "PREFLIGHT: PASS"
