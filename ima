#!/usr/bin/env bash

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT" || exit 1

CMD="${1:-help}"

case "$CMD" in
boot)
    python3 IMA_START.py
    ;;
status)
    python3 ima_status.py
    ;;
doctor)
    python3 ima_doctor.py
    ;;
repair)
    python3 ima_repair.py
    ;;
lock)
    python3 ima_lock.py
    ;;
snapshot)
    python3 ima_snapshot.py
    ;;
version)
    python3 ima_version.py
    ;;
product-audit)
    python3 ima_product_audit.py
    ;;
verify)
    python3 kernel/runtime/CANONICAL/IMA_WATCHDOG.py
    ;;
self-test)
    python3 ima_self_test.py
    ;;
runtime)
    python3 -c "import sys;sys.path.insert(0,'kernel/runtime/CANONICAL');import python_bridge;print(python_bridge.boot_runtime())"
    ;;
chat)
    python3 ima_system.py "${@:2}"
    ;;
sync)
    python3 ima_kernel.py >/dev/null 2>&1
    echo "[OK] sync complete"
    ;;
help|*)
    echo "IMA Canonical CLI"
    echo "ima boot"
    echo "ima status"
    echo "ima doctor"
    echo "ima repair"
    echo "ima lock"
    echo "ima snapshot"
    echo "ima version"
    echo "ima verify"
    echo "ima runtime"
    echo "ima chat"
    echo "ima sync"
    echo "ima self-test"
    echo "ima product-audit"
    ;;
esac
