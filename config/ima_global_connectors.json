{
  "schema": "ima.global-connectors.v1",
  "status": "registry-ready",
  "principle": "register capabilities; never claim an unverified connection",
  "connection_states": [
    "discovered",
    "authorization_required",
    "authorized",
    "health_checked",
    "live",
    "degraded",
    "disabled"
  ],
  "classes": {
    "human": ["community", "education", "research", "language", "culture", "developer"],
    "discovery": ["search", "web", "datasets", "scientific", "documentation", "standards"],
    "software": ["source_control", "project_management", "documents", "communication", "design", "analytics", "automation", "cloud"],
    "commerce": ["commerce", "marketplace", "affiliate", "payments", "crm", "support", "fulfillment", "subscriptions"],
    "media": ["publishing", "social", "video", "audio", "image", "advertising", "newsletter", "app_distribution"],
    "devices": ["android", "web", "pwa", "iot", "matter", "xr", "robotics", "future_physical_interfaces"]
  },
  "installed_verified": [
    "github",
    "render",
    "stripe",
    "dropbox",
    "canva",
    "runway",
    "posthog"
  ],
  "pending_user_authorization": [
    "windsor_ai",
    "shopify",
    "notion",
    "linear",
    "slack",
    "atlassian"
  ],
  "provider_record": {
    "required": [
      "id",
      "class",
      "capabilities",
      "languages",
      "auth",
      "privacy_scope",
      "provenance",
      "health_check",
      "write_policy"
    ]
  },
  "write_policy": {
    "default": "proof_gated",
    "irreversible": "explicit_authorization",
    "financial": "explicit_authorization_and_provider_confirmation",
    "outreach": "consent_required"
  }
}
