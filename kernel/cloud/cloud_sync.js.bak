const fs = require("fs")
const https = require("https")
const path = require("path")

const ROOT = process.env.HOME + "/ima_kernel"

const KEY_FILE = path.join(
ROOT,
"kernel/cloud/api_keys.json"
)

function loadKeys(){
try{
const raw = fs.readFileSync(KEY_FILE,"utf8")

const json = JSON.parse(raw)

return {
  primary: (json.primary || "").trim(),
  secondary: (json.secondary || "").trim()
}

} catch(e){

return {
  primary:"",
  secondary:""
}

}
}

function request(apiKey,prompt){

return new Promise((resolve)=>{

if(!apiKey){

  resolve({
    ok:false,
    text:"EMPTY_KEY"
  })

  return
}

const safeKey = encodeURIComponent(
  apiKey.trim()
)

const body = JSON.stringify({
  contents:[
    {
      parts:[
        {
          text:prompt
        }
      ]
    }
  ]
})

const req = https.request({

  hostname:
  "generativelanguage.googleapis.com",

  path:
  "/v1beta/models/gemini-1.5-flash:generateContent?key="
  + safeKey,

  method:"POST",

  headers:{
    "Content-Type":"application/json",
    "Content-Length":
    Buffer.byteLength(body)
  }

},(res)=>{

  let data = ""

  res.on("data",(c)=>{
    data += c
  })

  res.on("end",()=>{

    try{

      const json = JSON.parse(data)

      const text =
      json.candidates?.[0]
      ?.content?.parts?.[0]
      ?.text || "[EMPTY RESPONSE]"

      resolve({
        ok:true,
        text
      })

    } catch(e){

      resolve({
        ok:false,
        text:data
      })

    }

  })

})

req.on("error",(err)=>{

  resolve({
    ok:false,
    text:String(err)
  })

})

req.write(body)

req.end()

})

}

async function validateKeys(){

console.log(
"[VALIDATE] checking keys"
)

const keys = loadKeys()

if(keys.primary){

const r1 = await request(
  keys.primary,
  "hello"
)

console.log(
  "[PRIMARY]",
  r1.ok ? "CONNECTED" : "FAILED"
)

}

if(keys.secondary){

const r2 = await request(
  keys.secondary,
  "hello"
)

console.log(
  "[SECONDARY]",
  r2.ok ? "CONNECTED" : "FAILED"
)

}

return true
}

function snapshot(){

const files = []

function walk(dir){

const list = fs.readdirSync(
  dir,
  { withFileTypes:true }
)

for(const item of list){

  const full =
  path.join(dir,item.name)

  if(
    full.includes("node_modules")
  ) continue

  if(item.isDirectory()){

    walk(full)

  } else {

    files.push(full)

  }

}

}

walk(ROOT)

return {
files: files.length,
sample: files.slice(0,50),
ts: Date.now()
}
}

async function sync(){

const keys = loadKeys()

const snap = snapshot()

const payload =
"IMA STATE:\n" +
JSON.stringify(snap,null,2)

console.log(
"[SYNC] files:",
snap.files
)

if(keys.primary){

const r1 = await request(
  keys.primary,
  payload
)

console.log(
  "[PRIMARY RESPONSE]",
  r1.text.slice(0,120)
)

}

if(keys.secondary){

const r2 = await request(
  keys.secondary,
  payload
)

console.log(
  "[SECONDARY RESPONSE]",
  r2.text.slice(0,120)
)

}

console.log(
"[SYNC COMPLETE]"
)

}

async function boot(){

console.log(
"[IMA CLOUD] boot"
)

await validateKeys()

await sync()

setInterval(sync,60000)

}

boot()
