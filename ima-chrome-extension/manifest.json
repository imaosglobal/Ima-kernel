{
  "manifest_version": 3,
  "name": "IMA Browser Bridge",
  "version": "0.1.0",
  "description": "Secure, user-controlled browser bridge for IMA. Works with the current tab without exporting passwords or cookies.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "action": {
    "default_title": "IMA Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
