#!/data/data/com.termux/files/usr/bin/bash
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[IMA] pre-push security guard..."
python3 kernel/runtime/CANONICAL/git_guard.py

echo "[IMA] boot validation (read-only)..."
IMA_GIT_VALIDATION=1 python3 IMA_START.py > "$HOME/ima_git_boot.log"
tail -n 8 "$HOME/ima_git_boot.log"

echo "[IMA] validating working tree..."
git diff --check

git status --short --branch

echo "[IMA] pre-push OK"
