#!/data/data/com.termux/files/usr/bin/bash
set -e

echo "[GIT] validating active Python..."

python -m compileall -q -x "HISTORY_ARCHIVE|_archive_|\.before_|_broken_backup|_backup\.py" kernel .ima/CANONICAL_AUTHORITY .ima/agi_evolution

python - <<'PY'
import json
from pathlib import Path

p = Path(".ima/CANONICAL_AUTHORITY/governance/CANONICAL_REGISTRY.json")
d = json.loads(p.read_text())

components = d.get("allowed_components", [])

if not isinstance(components, list):
    raise SystemExit("INVALID: allowed_components must be a list")

for component in components:
    if not isinstance(component, str) or not component.strip():
        raise SystemExit(f"INVALID canonical component: {component!r}")

print("[GIT] canonical registry OK")
PY

echo "[GIT] pre-commit OK"
