# Keep the Docker build context complete for the IMA API.
# The previous deny-all policy excluded requirements.txt and runtime modules.

**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/.ruff_cache/
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/node_modules/
**/.next/
**/storybook-static/
**/playwright-report/
**/test-results/
**/dist/
**/build/
**/target/
**/*.log
**/*.tmp
.git/
.github/
