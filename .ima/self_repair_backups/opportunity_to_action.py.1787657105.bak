
try:
    from founder.executive_ai.learning_journal.event_bus import emit_event
except ImportError:
    def emit_event(*args, **kwargs):
        # Optional learning-journal dependency.
        # Opportunity generation must remain operational if the journal
        # subsystem is unavailable.
        return None



from founder.executive_ai.global_intelligence.world_scanner import world_scanner
from founder.executive_ai.global_intelligence.ranking_engine import ranker
from founder.executive_ai.action_engine.action_memory import get_actions
from founder.executive_ai.economic_intelligence.economic_engine import evaluate_action_economics


def generate_actions():
    """
    Generate canonical world actions.

    The generator is memory-aware:
    an identical action/target/score already recorded in action memory
    is not generated again.
    """

    emit_event(
        "action_engine",
        "action_generation_started",
        {},
        50
    )

    signals = world_scanner.scan_sources()
    ranked = ranker(signals)

    # --------------------------------------------------------
    # Load historical actions
    # --------------------------------------------------------
    try:
        history = get_actions()
    except Exception:
        history = []

    if not isinstance(history, list):
        history = []

    seen = set()

    for record in history:
        if not isinstance(record, dict):
            continue

        # memory_store wraps the actual action under "value".
        # Support both wrapped and legacy records.
        payload = record.get("value", record)

        if not isinstance(payload, dict):
            continue

        action = payload.get("action")
        result = payload.get("result", {})

        if isinstance(action, dict):
            action_name = action.get("action")
            target = action.get("target")
            score = action.get("score")
        else:
            action_name = action
            target = payload.get("target")
            score = payload.get("score")

        if isinstance(result, dict):
            target = result.get("target", target)
            score = result.get("score", score)

        # Historical action identity is action + target.
        # Score may legitimately change between cycles.
        seen.add((
            str(action_name),
            str(target)
        ))

    actions = []

    for item in ranked:

        # --------------------------------------------------------
        # Normalize ranking record
        # --------------------------------------------------------
        opportunity_score = float(
            item.get(
                "opportunity_score",
                item.get("rank_score", item.get("score", 0)),
            ) or 0
        )

        target = (
            item.get("title")
            or item.get("name")
            or item.get("target")
            or item.get("entity", {}).get("name")
            or "unknown"
        )

        # --------------------------------------------------------
        # Economic intelligence is mandatory at decision time.
        # Never allow missing economics to silently become zero.
        # --------------------------------------------------------
        economic_action = {
            "action": "create_personal_outreach",
            "target": target,
            "score": opportunity_score,
        }

        try:
            economics = evaluate_action_economics(economic_action)
        except Exception as exc:
            economics = {
                "expected_revenue": 0.0,
                "contribution_profit": 0.0,
                "roi": 0.0,
                "economic_error": str(exc),
            }

        expected_revenue = float(
            economics.get("expected_revenue", 0.0) or 0
        )

        contribution_profit = float(
            economics.get("contribution_profit", 0.0) or 0
        )

        roi = float(
            economics.get("roi", 0.0) or 0
        )

        economic_score = (
            expected_revenue
            + contribution_profit
            + (roi * 10.0)
        )

        final_score = opportunity_score + economic_score

        # --------------------------------------------------------
        # Canonical autonomous decision policy
        # --------------------------------------------------------
        if final_score >= 140:
            action_name = "create_personal_outreach"
            reason = "high strategic and economic value"

        elif final_score >= 100:
            action_name = "prepare_public_impact_message"
            reason = "strong strategic/economic opportunity"

        elif final_score >= 60:
            action_name = "monitor"
            reason = "potential opportunity requiring observation"

        else:
            continue

        # Identity is action + target.
        fingerprint = (
            str(action_name),
            str(target),
        )

        if fingerprint in seen:
            continue

        action = {
            "action": action_name,
            "target": target,
            "reason": reason,
            "score": opportunity_score,
            "economic_score": economic_score,
            "final_score": final_score,
            "economics": economics,
        }

        actions.append(action)
        seen.add(fingerprint)

    return actions

