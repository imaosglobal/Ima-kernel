{
  "schema_version": "1.1",
  "name": "IMA Plugin Capability Registry",
  "policy": {
    "discover": "continuously",
    "prefer_connected": true,
    "never_autoinstall_without_user_authorization": true,
    "require_verified_capability_before_claiming": true,
    "least_privilege": true,
    "no_secret_persistence": true,
    "continuous_learning": "observe→map→connect→execute→verify→document→reassess",
    "capability_truth_dimensions": [
      "discovered",
      "connected",
      "authenticated",
      "executable",
      "tested",
      "verified",
      "generalized"
    ],
    "auto_plugin_creation": "allowed_for_new_first_party_adapters; external_provider_connection_requires_authorization",
    "commercialization": "revenue_optimization_with_provider_terms_and_user_value_constraints",
    "capability_gap_lifecycle": [
      "detected",
      "specified",
      "scaffolded",
      "implemented",
      "tested",
      "verified",
      "published",
      "monitored",
      "reassessed"
    ],
    "learning_influence": "verified_evidence_only; bounded_small_changes; immutable_identity_laws_provenance_permissions"
  },
  "connected": [
