      "runway"
    ],
    "files_and_knowledge": [
      "dropbox",
      "github"
    ],
    "email": [
      "nylas_ima_runtime",
      "mailbox"
    ],
    "analytics": [
      "posthog"
    ],
    "payments": [
      "stripe"
    ],
    "project_management": [
      "clickup"
    ],
    "web_research_and_monitoring": [
      "tinyfish"
    ],
    "external_plugin_discovery": [
      "plugin_management"
    ],
    "creative_generation": [
      "runway",
      "canva",
      "openart_candidate",
      "heygen_candidate",
      "higgsfield_candidate"
    ],
    "audio_music": [
      "runway"
    ],
    "avatar_and_voice": [
      "runway",
      "heygen_candidate"
    ],
    "video": [
      "runway",
      "openart_candidate",
      "heygen_candidate",
      "descript_candidate",
      "higgsfield_candidate"
    ],
    "apps_and_websites": [
      "base44",
      "lovable",
      "higgsfield_candidate",
      "wix_candidate"
    ],
    "discovery_and_learning": [
      "tinyfish",
      "plugin_management",
      "github"
    ]
  }
}
