{
  "schema_version": "1.0",
  "name": "IMA Plugin Capability Registry",
  "policy": {
    "discover": "continuously",
    "prefer_connected": true,
    "never_autoinstall_without_user_authorization": true,
    "require_verified_capability_before_claiming": true,
    "least_privilege": true,
    "no_secret_persistence": true
  },
  "connected": [
    {"id":"automations","provider":"ChatGPT","capabilities":["scheduling","recurring_checks","conditional_tasks"]},
    {"id":"base44","provider":"Base44","capabilities":["app_build","web_build","backend","deployment"]},
    {"id":"canva","provider":"Canva","capabilities":["design","presentations","images","documents","brand_review"]},
    {"id":"clickup","provider":"ClickUp","capabilities":["tasks","docs","chat","project_management"]},
    {"id":"dropbox","provider":"Dropbox","capabilities":["file_search","file_read","file_requests","file_organization"]},
    {"id":"github","provider":"GitHub","capabilities":["repository_read_write","issues","pull_requests","ci_workflows"]},
    {"id":"lovable","provider":"Lovable","capabilities":["full_stack_app_build","web_development","deployment"]},
    {"id":"mailbox","provider":"Mailbox","capabilities":["email_read","email_search","email_reply"]},
    {"id":"posthog","provider":"PostHog","capabilities":["analytics","feature_flags","errors","experiments"]},
    {"id":"remote_desktop","provider":"Remote Desktop Commander","capabilities":["authorized_filesystem","terminal","computer_operations"]},
    {"id":"render","provider":"Render","capabilities":["deployments","logs","services","environment_variables","postgres"]},
    {"id":"runway","provider":"Runway","capabilities":["image_generation","video_generation","audio_generation","media_editing"]},
    {"id":"stripe","provider":"Stripe","capabilities":["payments","products","prices","payment_links","subscriptions"]},
    {"id":"tinyfish","provider":"TinyFish","capabilities":["web_search","page_reading","browser_workflows","monitors"]},
    {"id":"plugin_management","provider":"ChatGPT","capabilities":["plugin_discovery","plugin_permission_inspection","plugin_suggestions"]}
  ],
  "routing": {
    "code_and_deploy": ["github","render","base44","lovable"],
    "design_and_media": ["canva","runway"],
    "files_and_knowledge": ["dropbox","github"],
    "email": ["nylas_ima_runtime","mailbox"],
    "analytics": ["posthog"],
    "payments": ["stripe"],
    "project_management": ["clickup"],
    "web_research_and_monitoring": ["tinyfish"],
    "external_plugin_discovery": ["plugin_management"]
  }
}