MEMORY_FILE = "learning/learning_memory.json"


def final_write_filter(obj):
    marker="העמקת יכולת IMA"

    if isinstance(obj,str):
        if obj.count(marker)>1:
            return sanitize_ima_text(obj)

    if isinstance(obj,dict):
        return {k:final_write_filter(v) for k,v in obj.items()}

    if isinstance(obj,list):
        return [final_write_filter(x) for x in obj]

    return obj

# IMA_FINAL_WRITE_FILTER


def sanitize_ima_text(value):
    if isinstance(value, str):
        marker = "העמקת יכולת IMA"
        if value.count(marker) > 1:
            if "feedback_pattern:successful_pattern" in value:
                return "העמקת יכולת IMA בתחום feedback_pattern:successful_pattern"
            if "תודעה היא תחום מרכזי" in value:
                return "העמקת יכולת IMA בתחום הרחבת ידע תודעה"
            return "העמקת יכולת IMA בתחום כללי"
    return value


def sanitize_memory(obj):
    if isinstance(obj, dict):
        return {k: sanitize_memory(v) for k,v in obj.items()}
    if isinstance(obj, list):
        return [sanitize_memory(x) for x in obj]
    return sanitize_ima_text(obj)

# IMA_MEMORY_SANITIZER

from pathlib import Path
import json
from datetime import datetime

FILE = Path("learning/learning_memory.json")


def load_memory():
    try:
        return json.loads(FILE.read_text(encoding="utf-8"))
    except:
        return {
            "patterns": [],
            "successful_answers": [],
            "failed_answers": [],
            "decisions": []
        }


def save_memory(data):

    data = final_write_filter(data)

    for key, value in data.items():

        if isinstance(value, list):

            seen=set()
            cleaned=[]

            for item in value:

                marker=json.dumps(
                    item,
                    sort_keys=True,
                    ensure_ascii=False
                )

                if marker not in seen:
                    seen.add(marker)
                    cleaned.append(item)

            data[key]=cleaned


    with open(MEMORY_FILE,"w") as f:
        json.dump(
            data,
            f,
            ensure_ascii=False,
            indent=2
        )


def store_pattern(pattern):
    pattern = final_write_filter(pattern)

    if not pattern:
        return None

    data = load_memory()

    data.setdefault("patterns", [])

    for item in data["patterns"]:
        if final_write_filter(item.get("pattern")) == pattern:
            return item

    item = {
        "time": str(datetime.now()),
        "pattern": pattern
    }

    data["patterns"].append(item)

    save_memory(data)

    return item


def store_evaluation(question, score, note):
    data = load_memory()

    data.setdefault("evaluations", [])

    data["evaluations"].append({
        "question": question,
        "score": score,
        "note": note
    })

    if score >= 0.8:
        data["successful_answers"].append({
            "question": question,
            "note": note
        })
    else:
        data["failed_answers"].append({
            "question": question,
            "note": note
        })

    save_memory(data)


def get_learning_memory():
    return load_memory()


# --- IMA Pattern Memory Layer ---

import json
import time

PATTERN_MEMORY_FILE = "learning/learning_patterns.json"


def _load_patterns():
    try:
        with open(PATTERN_MEMORY_FILE,"r") as f:
            return json.load(f)
    except:
        return {"patterns":[]}


def _save_patterns(data):
    data = final_write_filter(data)
    data = sanitize_memory(data)
    with open(PATTERN_MEMORY_FILE,"w") as f:
        json.dump(
            data,
            f,
            ensure_ascii=False,
            indent=2
        )


def store_pattern_layer(pattern):

    pattern = final_write_filter(pattern)

    data=_load_patterns()

    for item in data["patterns"]:
        existing = final_write_filter(item["pattern"])

        if existing == pattern:
            item["count"] += 1
            item["last_seen"]=time.time()
            _save_patterns(data)
            return item

    item={
        "pattern":pattern,
        "count":1,
        "created":time.time(),
        "last_seen":time.time()
    }

    data["patterns"].append(item)

    _save_patterns(data)

    return item


def get_patterns(limit=10):

    data=_load_patterns()

    return sorted(
        data["patterns"],
        key=lambda x:x.get("count",0),
        reverse=True
    )[:limit]

