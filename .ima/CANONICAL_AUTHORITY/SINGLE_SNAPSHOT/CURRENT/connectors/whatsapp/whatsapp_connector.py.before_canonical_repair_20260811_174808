import json
import sys
from pathlib import Path


# ------------------------------------------------------------
# CANONICAL IMA WhatsApp Connector
# Source of truth:
#   CANONICAL + runtime.stream.emit + memory_log.jsonl
# ------------------------------------------------------------

ROOT = Path(__file__).resolve().parents[6]
RUNTIME = ROOT / ".ima" / "runtime"

if str(RUNTIME) not in sys.path:
    sys.path.insert(0, str(RUNTIME))

from stream import emit


MEMORY_LOG = ROOT / ".ima" / "memory_log.jsonl"


def _read_memory():
    if not MEMORY_LOG.exists():
        return []

    events = []

    with MEMORY_LOG.open("r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            try:
                events.append(json.loads(line))
            except Exception:
                continue

    return events


def _last_message(user_id):
    events = _read_memory()

    for event in reversed(events):
        if (
            event.get("type") in (
                "whatsapp.message_received",
                "whatsapp.message.received",
            )
            and event.get("user_id") == user_id
        ):
            return event.get("message", "")

    return ""


class WhatsAppConnector:

    def receive_message(self, user_id, msg):
        msg = str(msg).strip()

        event = emit(
            "whatsapp.message_received",
            user_id=user_id,
            message=msg,
        )

        return event

    def send_message(self, user_id, text):
        text = str(text)

        event = emit(
            "whatsapp.reply.sent",
            user_id=user_id,
            response=text,
        )

        # שכבת התעבורה בפועל יכולה להחליף את ה-print
        # בלי לשנות את ה-event/memory architecture.
        print(f"SEND TO {user_id}: {text}")

        return event

    def last_message(self, user_id):
        return _last_message(user_id)


whatsapp = WhatsAppConnector()
