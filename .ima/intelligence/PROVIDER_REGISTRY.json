{
  "schema": "IMA-PROVIDER-REGISTRY-2.0",
  "purpose": "Canonical provider-neutral intelligence interoperability registry for IMA.",
  "truth_rule": "DISCOVERED is not CONNECTED. CONNECTED and RUNTIME-VERIFIED require actual implementation and runtime evidence.",
  "lifecycle": [
    "DISCOVERED",
    "ELIGIBLE",
    "ADAPTER-READY",
    "AUTHORIZED",
    "CONNECTED",
    "RUNTIME-VERIFIED",
    "MONITORED"
  ],
  "promotion_requirements": {
    "ELIGIBLE": ["official_evidence", "protocol_or_capability_match", "authorization_path_known"],
    "ADAPTER-READY": ["adapter_implementation_exists", "reproducible_test_exists"],
    "AUTHORIZED": ["explicit_credentials_or_permission_evidence"],
    "CONNECTED": ["real_connection_evidence"],
    "RUNTIME-VERIFIED": ["successful_live_runtime_request", "observed_result", "provenance_recorded"],
    "MONITORED": ["recurring_health_or_capability_check"]
  },
  "policy": {
    "provider_neutral": true,
    "single_canonical_registry": true,
    "no_parallel_live_browser_system": true,
    "minimum_necessary_context": true,
    "explicit_user_authorization_for_cross_provider_sharing": true,
    "no_silent_cross_provider_sharing": true,
    "provenance_required": true,
    "private_by_default": true,
    "auto_connect_external_provider": false,
    "never_store_provider_secrets": true,
    "consequential_actions_require_explicit_confirmation": true,
    "a_to_b_must_be_ima_mediated": true,
    "ima_can_answer_directly": true,
    "ima_can_query_multiple_intelligences": true,
    "ima_can_compare_synthesize_and_disagree": true,
    "ima_can_answer_other_intelligences": true
  },
  "protocols": {
    "MCP": {
      "status": "DISCOVERED",
      "official_evidence": "https://modelcontextprotocol.io/",
      "role": "model/agent to tools, resources and context"
    },
    "A2A": {
      "status": "DISCOVERED",
      "official_evidence": "https://a2a-protocol.org/",
      "role": "agent-to-agent interoperability",
      "ima_rule": "A2A traffic is mediated by IMA when used by IMA; no direct provider-to-provider sharing without explicit authorization."
    }
  },
