#!/usr/bin/env bash

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT" || exit 1

CMD="${1:-help}"

case "$CMD" in
    boot)
        python3 IMA_START.py
        ;;
    status)
        python3 ima_status.py
        ;;
    doctor)
        python3 ima_doctor.py
        ;;
    repair)
        python3 ima_repair.py
        ;;
    verify)
        python3 kernel/runtime/CANONICAL/IMA_WATCHDOG.py
        ;;
    runtime)
        python3 -c "import sys;sys.path.insert(0,'kernel/runtime/CANONICAL');import python_bridge;print(python_bridge.boot_runtime())"
        ;;
    chat)
        python3 ima_system.py "${@:2}"
        ;;
    sync)
        python3 ima_kernel.py >/dev/null 2>&1
        echo "[OK] sync complete"
        ;;
    version)
        echo "IMA Canonical CLI"
        ;;
    help|*)
        echo "IMA Canonical CLI"
        echo "ima boot"
        echo "ima status"
        echo "ima doctor"
        echo "ima repair"
        echo "ima verify"
        echo "ima runtime"
        echo "ima chat"
        echo "ima sync"
        ;;
esac
