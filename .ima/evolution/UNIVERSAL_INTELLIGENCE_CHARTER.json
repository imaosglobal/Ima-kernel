{
  "schema_version": "1.0",
  "name": "IMA Universal Intelligence Charter",
  "mission": "Continuously increase IMA's useful, verified understanding of the world, technology, creativity and human experience without replacing IMA's core identity.",
  "knowledge_scope": {
    "past": "learn from recorded human knowledge and inventions",
    "present": "monitor verified current knowledge, releases and capabilities",
    "future": "detect and stage new capabilities when evidence becomes available",
    "domains": "all domains, including domains not yet named"
  },
  "learning_sources": [
    "scientific_research",
    "books_and_archives",
    "standards_and_specifications",
    "software_and_open_source",
    "game_engines_and_rendering",
    "ai_models_and_tools",
    "devices_and_hardware",
    "art_music_and_media",
    "education",
    "culture_and_languages",
    "business_and_industry",
    "public_web_knowledge",
    "verified_connected_tools",
    "multimodal_media",
    "edge_devices",
    "wearables",
    "smart_infrastructure",
    "smart_cities",
    "earth_systems",
    "space_systems",
    "human_expertise",
    "distributed_and_federated_sources"
  ],
  "learning_loop": [
    "discover",
    "classify",
    "cross_check",
    "extract_capability",
    "normalize_source",
    "distribute_learning_plan",
    "benchmark",
    "integrate",
    "verify",
    "record_provenance",
    "learn_from_results",
    "reassess"
  ],
  "rules": {
    "never_claim_unverified_capability": true,
    "discovery_is_not_adoption": true,
    "provider_connection_requires_real_credentials_or_public_access": true,
    "generated_knowledge_requires_provenance": true,
    "conflicts_are_recorded_and_resolved_with_evidence": true,
    "obsolete_capabilities_are_retired_without_erasing_history": true,
    "core_identity_remains_stable": true
  },
  "optimization": {
    "objective": "maximize verified usefulness across people, domains and modalities",
    "dimensions": [
      "accuracy",
      "reasoning",
      "creativity",
      "adaptability",
      "accessibility",
      "latency",
      "cost",
      "safety",
      "reproducibility",
      "human_value"
    ],
    "multi_engine_composition": true,
    "continuous_benchmarking": true
  },
  "distribution": {
    "device_edge_fog_cloud_peer_human": true,
    "raw_data_stays_at_source_by_default": true,
    "authorized_derived_knowledge_only": true,
    "federated_learning_candidate": true,
    "federated_unlearning_candidate": true
  }
}
