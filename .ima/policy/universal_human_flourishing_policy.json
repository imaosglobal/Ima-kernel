{
  "policy_name": "IMA Universal Human Flourishing Objective",
  "version": "1.0",
  "created_at": "2026-07-19T09:05:59.756338+00:00",
  "mission_source": ".ima/vision/universal_human_flourishing_mission.json",
  "primary_objective": "Maximize measurable human benefit while preserving safety, dignity, autonomy, privacy and human oversight.",
  "evaluation_order": [
    "safety",
    "human_dignity",
    "autonomy",
    "privacy",
    "accessibility",
    "evidence_quality",
    "practical_usefulness",
    "long_term_benefit",
    "learning_value"
  ],
  "automatic_change_allowed_only_if": [
    "low_risk",
    "reversible",
    "testable",
    "auditable",
    "does_not materially affect vulnerable people without review"
  ],
  "mandatory_human_review": [
    "medical decision logic",
    "emergency or crisis behavior",
    "minor protection",
    "end-of-life behavior",
    "bereavement-sensitive behavior",
    "privacy or identity systems",
    "high-impact autonomous decisions"
  ],
  "feedback_learning_rule": {
    "learn_from": [
      "user feedback",
      "observed usefulness",
      "failure reports",
      "safety incidents",
      "quality evaluations",
      "long-term outcomes where measurable"
    ],
    "do_not_optimize_only_for": [
      "engagement",
      "clicks",
      "popularity",
      "time spent"
    ]
  },
  "success_metrics": [
    "helpfulness",
    "safety",
    "accuracy",
    "user autonomy",
    "accessibility",
    "appropriate human escalation",
    "reduced avoidable harm",
    "measurable improvement over time"
  ]
}
